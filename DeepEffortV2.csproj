<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!--
      net8.0-windows gives us System.Drawing (GDI+) without an extra package.
      ATAS is Windows-only so this TFM is always correct.
      If your ATAS installation targets .NET 6, change this to net6.0-windows.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>DeepEffortV2</AssemblyName>
    <RootNamespace>DeepEffortV2Indicator</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      OFT.Indicators is the official ATAS custom-indicator SDK on NuGet.org.
      It provides: Indicator base class, IndicatorCandle, RenderContext,
      DrawingLayouts, ChartInfo, and all supporting types.

      If NuGet restore fails (no internet / private environment):
        1. Comment out this PackageReference.
        2. Add <Reference> entries pointing at the DLLs inside your ATAS
           installation folder (typically C:\Program Files\ATAS):
               ATAS.Indicators.dll
               OFT.Rendering.dll
               ATAS.DataFeedsCore.dll
    -->
    <PackageReference Include="OFT.Indicators" Version="*" />
  </ItemGroup>

</Project>
