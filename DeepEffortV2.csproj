<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!--
      net8.0-windows gives us System.Drawing (GDI+) without an extra package.
      ATAS is Windows-only so this TFM is always correct.
      If your ATAS installation targets .NET 6, change this to net6.0-windows.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>DeepEffortV2</AssemblyName>
    <RootNamespace>DeepEffortV2Indicator</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- ATAS local DLL references — adjust HintPaths if ATAS is installed elsewhere -->
    <Reference Include="OFT.Indicators">
      <HintPath>C:\Program Files (x86)\ATAS Platform\OFT.Indicators.dll</HintPath>
    </Reference>
    <Reference Include="OFT.Core">
      <HintPath>C:\Program Files (x86)\ATAS Platform\OFT.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
